# Provider credential. Never commit a real value.
OPENROUTER_API_KEY=

# Private credential used by clients calling Add/Search.
JETRIEVER_API_KEY=

JEV_MODEL=~typesafe/jev-latest
JEV_CONCURRENCY=32
JEV_TIMEOUT_SECONDS=20
JEV_MAX_RETRIES=5
BACKEND_RETRY_AFTER_SECONDS=15
JETRIEVER_RESULT_LIMIT=5
RETENTION_DAYS=30
AUDIT_LOG_PATH=./log/audit.jsonl
AUDIT_LOG_MAX_BYTES=104857600
AUDIT_LOG_BACKUPS=20
